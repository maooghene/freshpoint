generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  clerkId      String        @unique
  role         UserRole      @default(CUSTOMER)
  firstName    String?
  lastName     String?
  email        String        @unique
  phone        String?
  image        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isBanned     Boolean       @default(false) 
  addresses    Address[]
  bookings     Booking[]
  businesses   Business[]    @relation("BusinessOwner")
  carts        Cart[]
  complaints   Complaint[]
  orders       Order[]
  ratings      Rating[]
  staffProfile StaffProfile?
  platformAdminProfile PlatformAdminProfile?
  createdAnnouncements    Announcement[]          @relation("AnnouncementCreator")
  announcementDismissals  AnnouncementDismissal[]

  @@index([email])
  @@index([clerkId])
}

model Business {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  email             String
  phone             String
  address           String
  sittingCapacity   Int                @default(1)
  categories        String[]           @default([])
  description       String?
  image             String?
  status            String             @default("pending")
  isActive          Boolean            @default(false)
  isPayoutFrozen    Boolean            @default(false) // Emergency switch to freeze cash out during disputes
  latitude          Float              @default(6.5244)
  longitude         Float              @default(3.3792)
  ownerId           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bufferTimeMinutes Int                @default(0)
  cancelWindowHours Int                @default(24)
  currencyCode      String             @default("NGN")
  customInvoiceNote String?
  depositPercentage Int                @default(0)
  emailAlertsActive Boolean            @default(true)
  maxAheadDays      Int                @default(30)
  minNoticeHours    Int                @default(2)
  requireDeposit    Boolean            @default(false)
  smsAlertsActive   Boolean            @default(false)
  timezone          String             @default("Africa/Lagos")
  baseDeliveryFee   Float              @default(0)
  deliveryFeePerKm  Float              @default(0)
  bookings          Booking[]
  owner             User               @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  schedules         BusinessSchedule[]
  carts             Cart[]
  complaints        Complaint[]
  items             Item[]
  orders            Order[]
  ratings           Rating[]
  staff             StaffProfile[]
  announcements Announcement[]

  @@index([ownerId])
}

model StaffProfile {
  id         String          @id @default(cuid())
  name       String
  role       String          @default("Specialist")
  email      String
  isActive   Boolean         @default(false)
  userId     String?         @unique
  businessId String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  bookings   Booking[]
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id])
  schedules  StaffSchedule[]

  @@unique([businessId, email])
  @@index([businessId])
}

model StaffSchedule {
  id        String       @id @default(cuid())
  staffId   String
  day       DayOfWeek
  startTime String
  endTime   String
  isOff     Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, day])
}

model BusinessSchedule {
  id         String    @id @default(cuid())
  businessId String
  day        DayOfWeek
  openTime   String
  closeTime  String
  isClosed   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
}

model PlatformAdminProfile {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  adminRole PlatformAdminRole @default(SUPPORT_AGENT)
  isActive  Boolean           @default(true)

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  action      String
  targetType  String
  targetId    String
  targetLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Item {
  id          String        @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int?          @default(0)
  sku         String?
  costPrice   Float?
  weight      Float?
  duration    Int?          @default(30)
  isActive    Boolean       @default(true)
  type        ItemType      @default(SERVICE)
  image       String?
  businessId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bookings    BookingItem[]
  cartItems   CartItem[]
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  ratings     Rating[]

  @@index([businessId])
  @@index([businessId, type, isActive])
}

model Booking {
  id                String        @id @default(cuid())
  startTime         DateTime
  endTime           DateTime
  status            BookingStatus @default(CONFIRMED)
  locationType      LocationType  @default(IN_SHOP)
  notes             String?
  paymentReference  String?       @unique
  paymentStatus     String?       @default("pending")
  totalAmount       Float?
  freshpointFee     Float?
  providerPayout    Float?
  freshpointNet     Float?
  queueCode         String?
  isVerifiedByStaff Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  addressId         String?
  businessId        String
  userId            String
  staffId           String?
  address           Address?      @relation(fields: [addressId], references: [id])
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff             StaffProfile? @relation(fields: [staffId], references: [id])
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             BookingItem[]
  ratings           Rating[]

  @@index([businessId, staffId, startTime, endTime])
  @@index([userId])
  @@index([addressId])
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  itemId    String
  price     Float
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([itemId])
}

model Order {
  id              String      @id @default(cuid())
  code            String      @unique
  userId          String
  businessId      String
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  isDelivery      Boolean     @default(false)
  deliveryAddress String?
  deliveryNotes   String?
  deliveryFee     Float       @default(0.0)
  addressId       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  address         Address?    @relation(fields: [addressId], references: [id])
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([businessId])
  @@index([userId])
  @@index([addressId])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  itemId   String
  quantity Int
  price    Float
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([itemId])
}

model Rating {
  id         String   @id @default(cuid())
  rating     Int
  review     String?
  isApproved Boolean  @default(true)
  userId     String
  itemId     String?
  businessId String
  bookingId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking? @relation(fields: [bookingId], references: [id])
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  item       Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([itemId])
  @@index([userId])
  @@index([bookingId])
}

model Address {
  id        String    @id @default(cuid())
  street    String
  city      String
  state     String?
  zipCode   String
  isDefault Boolean   @default(false)
  userId    String
  latitude  Float?
  longitude Float?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  orders    Order[]

  @@index([userId])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@unique([userId, businessId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  itemId     String
  quantity   Int      @default(1)
  priceAtAdd Float?
  createdAt  DateTime @default(now())
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([itemId])
}

model Complaint {
  id         String            @id @default(cuid())
  userId     String
  businessId String?
  orderCode  String?
  bookingId  String?
  category   ComplaintCategory
  severity   ComplaintSeverity
  assignedTo ComplaintAssignee
  status     ComplaintStatus   @default(OPEN)
  summary    String
  rawMessage String
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?
  business   Business?         @relation(fields: [businessId], references: [id])
  user       User              @relation(fields: [userId], references: [id])

  @@index([businessId, status])
  @@index([assignedTo, status])
}

model SystemSetting {
  id                     String   @id @default("singleton")
  bookingCommissionPct   Int      @default(8)
  productCommissionPct   Int      @default(5)
  minGlobalDeliveryFee   Float    @default(200)
  platformPayoutFloor    Float    @default(2000)
  maintenanceModeActive  Boolean  @default(false)
  allowNewRegistrations  Boolean  @default(true)
  enforceInstantApproval Boolean  @default(true)
  maxDailyBookingsPerUser Int     @default(5)
  maxDistanceLimitKm     Float    @default(35.0)

  // ONLY ADD THESE TWO LINES HERE INSIDE THE ORIGINAL BLOCK:
  payoutHoldingPeriodDays Int     @default(3)
  absorbPaystackFees     Boolean  @default(false)
  globalAlertBannerText   String?

  updatedAt              DateTime @updatedAt
}

model Announcement {
  id               String                  @id @default(cuid())
  title            String
  message          String
  severity         AnnouncementSeverity    @default(INFO)
  targetType       AnnouncementTargetType  @default(ALL)
  targetRole       UserRole?
  targetBusinessId String?
  targetBusiness   Business?               @relation(fields: [targetBusinessId], references: [id])
  startsAt         DateTime                @default(now())
  endsAt           DateTime?
  isActive         Boolean                 @default(true)
  createdById      String
  createdBy        User                    @relation("AnnouncementCreator", fields: [createdById], references: [id])
  dismissals       AnnouncementDismissal[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([isActive, targetType])
  @@index([targetBusinessId])
}

model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  dismissedAt    DateTime     @default(now())

  @@unique([announcementId, userId])
}

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  STAFF
  ADMIN
}

enum PlatformAdminRole {
  SUPER_ADMIN      // Complete destructive access across the platform
  PLATFORM_MANAGER // Management privileges excluding emergency system parameters
  SUPPORT_AGENT    // Exclusively manages and updates Complaints boards
  LOGISTICS_AUDITOR// Audits business location coordinates and delivery configurations
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AnnouncementTargetType {
  ALL
  ROLE
  BUSINESS
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ItemType {
  SERVICE
  PRODUCT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum LocationType {
  IN_SHOP
  MOBILE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ComplaintCategory {
  PAYMENT
  SERVICE_DELAY
  APP_BUG
  BUSINESS_CONDUCT
  OTHER
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ComplaintAssignee {
  ADMIN
  BUSINESS_OWNER
}
