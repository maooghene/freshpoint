generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS & CONFIGURATION
// ==========================================

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  STAFF
  ADMIN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ItemType {
  SERVICE
  PRODUCT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum LocationType {
  IN_SHOP
  MOBILE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ==========================================
// CORE USERS & TENANTS
// ==========================================

model User {
  id           String        @id @default(cuid())
  clerkId      String        @unique
  role         UserRole      @default(CUSTOMER)
  firstName    String?
  lastName     String?
  email        String        @unique
  phone        String?
  image        String?

  bookings     Booking[]
  ratings      Rating[]
  addresses    Address[]
  businesses   Business[]    @relation("BusinessOwner")
  staffProfile StaffProfile?  
  carts        Cart[]         
  orders       Order[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@index([clerkId])
}

model Business {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique // Essential for tenant subdomains or clean URL parameters
  email           String
  phone           String
  address         String
  sittingCapacity Int                @default(1) 
  categories      String[]           @default([])
  description     String?
  image           String?
  status          String             @default("pending")
  isActive        Boolean            @default(false)

  ownerId         String 
  owner           User               @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  items           Item[]     
  bookings        Booking[]
  ratings         Rating[]
  orders          Order[]
  schedules       BusinessSchedule[]
  staff           StaffProfile[]
  carts           Cart[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([ownerId])
}

// ==========================================
// SALON STAFF & AVAILABILITY
// ==========================================

model StaffProfile {
  id         String          @id @default(cuid())
  name       String   
  role       String          @default("Specialist") // 🔑 ADDED: Tracks the employee's title (e.g., "Barber", "Stylist")
  email      String          // 🔑 ADDED: Tracks the exact invitation address string before account registration
  isActive   Boolean         @default(false)        // 🔑 MODIFIED: Starts as false until they claim their invitation link!
  
  userId     String?         @unique
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  bookings   Booking[] 
  schedules  StaffSchedule[] // Track individual barber shifts/days off

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([businessId])
  @@unique([businessId, email]) // 🔒 Prevents a manager from accidentally sending double invites to the same person
}

model StaffSchedule {
  id         String       @id @default(cuid())
  staffId    String
  staff      StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  day        DayOfWeek
  startTime  String       // e.g., "09:00"
  endTime    String       // e.g., "18:00"
  isOff      Boolean      @default(false)

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([staffId, day])
}

model BusinessSchedule {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  day        DayOfWeek
  openTime   String 
  closeTime  String 
  isClosed   Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, day]) 
}

// ==========================================
// SALON RETAIL & SERVICES
// ==========================================

model Item {
  id          String        @id @default(cuid())
  name        String
  description String?
  price       Float    
  
  // Product Inventory (Retail items like pomades, oils)
  stock       Int?          @default(0)    
  sku         String?  
  costPrice   Float?   
  weight      Float?   
  
  // Service Booking (E.g., Haircut, Color treatments)
  duration    Int?          @default(30)   
  
  isActive    Boolean       @default(true)
  type        ItemType      @default(SERVICE) 
  image       String?
  
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  bookings    BookingItem[] // Transitioned to support single or multi-service salon slots
  ratings     Rating[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([businessId])
  @@index([businessId, type, isActive]) // Speeds up client catalog and scheduling engine checks
}

// ==========================================
// TRANSACTIONAL BOOKINGS & ORDERS
// ==========================================

model Booking {
  id               String        @id @default(cuid())
  startTime        DateTime
  endTime          DateTime
  status           BookingStatus @default(CONFIRMED)
  locationType     LocationType  @default(IN_SHOP)
  notes            String?

  paymentReference String?       @unique
  paymentStatus    String?       @default("pending")
  totalAmount      Float?
  
  // FreshPoint fee breakdown
  freshpointFee    Float?        // 8% commission
  providerPayout   Float?        // What provider receives after commission
  freshpointNet    Float?        // FreshPoint profit after Paystack fees

   queueCode        String?      // E.g., "FP-56" or "FP-102"
  isVerifiedByStaff Boolean       @default(false)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  addressId        String?
  address          Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)

  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  staffId          String?
  staff            StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  items            BookingItem[]
  ratings          Rating[]

  @@index([businessId, staffId, startTime, endTime])
  @@index([userId])
  @@index([addressId])
}

// Join table to unlock multiple bundled salon services in a single checkout session
model BookingItem {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price     Float    // Snapshots the service cost historical accuracy

  @@index([bookingId])
  @@index([itemId])
}

model Order {
  id              String      @id @default(cuid())
  code             String       @unique 
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId      String      
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  items           OrderItem[]
  totalAmount     Float
  status          OrderStatus @default(PENDING)

  isDelivery      Boolean     @default(false)
  deliveryAddress String?
  deliveryNotes   String?
  
  // NEW: Captures explicit delivery surcharge split out from subtotal lines
  deliveryFee     Float       @default(0.0)

  addressId       String?     
  address         Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([businessId])
  @@index([userId])
  @@index([addressId])
}


model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String  
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float   

  @@index([orderId])
  @@index([itemId])
}

model Rating {
  id         String   @id @default(cuid())
  rating     Int      
  review     String?

  // 🌟 ADDED FOR VENDOR MODERATION TOGGLE
  isApproved Boolean  @default(true)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🌟 FIXED: Made optional (?) to safely support general venue-wide reviews without a foreign key crash
  itemId     String?   
  item       Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  businessId String  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([itemId])
  @@index([userId])
  @@index([bookingId]) 
}



model Address {
  id        String    @id @default(cuid())
  street    String
  city      String
  state     String?
  zipCode   String
  isDefault Boolean   @default(false)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  orders    Order[]

  @@index([userId])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String     
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  items      CartItem[]
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt

  @@unique([userId, businessId]) 
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  itemId     String   
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  priceAtAdd Float?
  createdAt  DateTime @default(now())

  @@index([cartId])
  @@index([itemId]) 
}
