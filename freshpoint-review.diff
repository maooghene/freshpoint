@@ -0,0 +1,17 @@
+"use client";
+
+import { FormEvent, useState } from "react";
+
+export default function BroadcastForm({ businessId }: { businessId: string }) {
+  const [status, setStatus] = useState("");
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setStatus("");
+    const form = new FormData(event.currentTarget);
+    const response = await fetch(`/api/businesses/${businessId}/broadcast`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ title: form.get("title"), message: form.get("message") }) });
+    const data = await response.json();
+    setStatus(response.ok ? "Broadcast published." : data.error || "Could not publish broadcast.");
+    if (response.ok) (event.currentTarget as HTMLFormElement).reset();
+  }
+  return <form onSubmit={submit} className="space-y-4 rounded-2xl border border-border bg-card p-6"><h1 className="text-xl font-bold">Promotional broadcast</h1><input name="title" required minLength={3} placeholder="Title" className="w-full rounded-xl border border-border bg-background px-3 py-2" /><textarea name="message" required minLength={5} placeholder="Message" rows={5} className="w-full rounded-xl border border-border bg-background px-3 py-2" /><button className="rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Publish broadcast</button>{status && <p className="text-sm">{status}</p>}</form>;
+}
diff --git a/app/business/[slug]/broadcast/page.tsx b/app/business/[slug]/broadcast/page.tsx
new file mode 100644
index 0000000..a0d607a
--- /dev/null
+++ b/app/business/[slug]/broadcast/page.tsx
@@ -0,0 +1,21 @@
+import { redirect, notFound } from "next/navigation";
+import { auth } from "@clerk/nextjs/server";
+import { prisma } from "@/lib/prisma";
+import { authorizeBusinessAccess } from "@/lib/authorize-business-access";
+import BroadcastForm from "./BroadcastForm";
+import { hasPromotionalBroadcasts } from "@/lib/subscription-tiers";
+
+export default async function BroadcastPage({ params }: { params: Promise<{ slug: string }> }) {
+  const { slug } = await params;
+  const { userId } = await auth();
+  if (!userId) redirect("/sign-in");
+  const user = await prisma.user.findUnique({ where: { clerkId: userId }, select: { id: true } });
+  const business = await prisma.business.findUnique({ where: { slug }, select: { id: true, ownerId: true, subscriptionTier: true } });
+  if (!user || !business) notFound();
+  const authorized = await authorizeBusinessAccess({ businessId: business.id, ownerId: business.ownerId, systemUserId: user.id, allowStaff: false });
+  if (!authorized) redirect("/select-workspace");
+  if (!hasPromotionalBroadcasts(business.subscriptionTier)) {
+    return <main className="mx-auto max-w-3xl p-6"><div className="rounded-2xl border border-border bg-card p-6"><h1 className="text-xl font-bold">Promotional broadcasts</h1><p className="mt-2 text-sm text-muted-foreground">This perk is available on Pro.</p></div></main>;
+  }
+  return <main className="mx-auto max-w-3xl p-6"><BroadcastForm businessId={business.id} /></main>;
+}
