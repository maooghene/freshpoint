      <div className="mb-6 flex items-start gap-3 rounded-2xl border border-blue-500/10 bg-blue-500/5 p-4 text-xs md:text-sm text-blue-800 dark:border-blue-500/20 dark:bg-blue-950/20 dark:text-blue-400">
