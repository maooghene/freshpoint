=== PRISMA SCHEMA ===
--- ./prisma/schema.prisma ---
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  clerkId      String        @unique
  role         UserRole      @default(CUSTOMER)
  firstName    String?
  lastName     String?
  email        String        @unique
  phone        String?
  image        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isBanned     Boolean       @default(false) 
  addresses    Address[]
  bookings     Booking[]
  businesses   Business[]    @relation("BusinessOwner")
  carts        Cart[]
  complaints   Complaint[]
  orders       Order[]
  ratings      Rating[]
  staffProfile StaffProfile?
  platformAdminProfile PlatformAdminProfile?
  createdAnnouncements    Announcement[]          @relation("AnnouncementCreator")
  announcementDismissals  AnnouncementDismissal[]

  @@index([email])
  @@index([clerkId])
}

model Business {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  email             String
  phone             String
  address           String
  sittingCapacity   Int                @default(1)
  categories        String[]           @default([])
  description       String?
  image             String?
  status            String             @default("pending")
  isActive          Boolean            @default(false)
  isPayoutFrozen    Boolean            @default(false) // Emergency switch to freeze cash out during disputes
  latitude          Float              @default(6.5244)
  longitude         Float              @default(3.3792)
  ownerId           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bufferTimeMinutes Int                @default(0)
  cancelWindowHours Int                @default(24)
  currencyCode      String             @default("NGN")
  customInvoiceNote String?
  googleCredential  GoogleCredential?
  depositPercentage Int                @default(0)
  emailAlertsActive Boolean            @default(true)
  maxAheadDays      Int                @default(30)
  minNoticeHours    Int                @default(2)
  requireDeposit    Boolean            @default(false)
  smsAlertsActive   Boolean            @default(false)
  timezone          String             @default("Africa/Lagos")
  baseDeliveryFee   Float              @default(0)
  deliveryFeePerKm  Float              @default(0)
  bookings          Booking[]
  owner             User               @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  schedules         BusinessSchedule[]
  carts             Cart[]
  complaints        Complaint[]
  items             Item[]
  orders            Order[]
  ratings           Rating[]
  staff             StaffProfile[]
  announcements Announcement[]
  reminderMilestonesHours Int[]        @default([48, 2])

  @@index([ownerId])
}

model StaffProfile {
  id         String          @id @default(cuid())
  name       String
  role       String          @default("Specialist")
  email      String
  isActive   Boolean         @default(false)
  userId     String?         @unique
  businessId String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  bookings   Booking[]
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id])
  schedules  StaffSchedule[]

  @@unique([businessId, email])
  @@index([businessId])
}

model StaffSchedule {
  id        String       @id @default(cuid())
  staffId   String
  day       DayOfWeek
  startTime String
  endTime   String
  isOff     Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, day])
}

model BusinessSchedule {
  id         String    @id @default(cuid())
  businessId String
  day        DayOfWeek
  openTime   String
  closeTime  String
  isClosed   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
}

model PlatformAdminProfile {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  adminRole PlatformAdminRole @default(SUPPORT_AGENT)
  isActive  Boolean           @default(true)

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  action      String
  targetType  String
  targetId    String
  targetLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Item {
  id          String        @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int?          @default(0)
  sku         String?
  costPrice   Float?
  weight      Float?
   variants    ItemVariant[]
  duration    Int?          @default(30)
  isActive    Boolean       @default(true)
  type        ItemType      @default(SERVICE)
  image       String?
  businessId  String
  categoryId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bookings    BookingItem[]
  cartItems   CartItem[]
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  ratings     Rating[]

  @@index([businessId])
  @@index([businessId, type, isActive])
  @@index([categoryId])
}

model ItemVariant {
  id         String   @id @default(cuid())
  itemId     String
  size       String?  // e.g., "S", "M", "L", "42", "44"
  color      String?  // e.g., "Charcoal Black", "Emerald Green"
  price      Float?   // Override parent price if larger sizes cost more
  stock      Int      @default(0) // Inventory count specific to this size/color combination
  sku        String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model ItemCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  scope     CategoryScope @default(BOTH)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     Item[]
}

model BusinessCategory {
  id        String   @id @default(cuid())
  label     String   @unique
  value     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([value])
}

model Booking {
  id                String        @id @default(cuid())
  startTime         DateTime
  endTime           DateTime
  status            BookingStatus @default(CONFIRMED)
  locationType      LocationType  @default(IN_SHOP)
  notes             String?
  paymentReference  String?       @unique
  paymentStatus     String?       @default("pending")
  totalAmount       Float?
  freshpointFee     Float?
  providerPayout    Float?
  freshpointNet     Float?
  queueCode         String?
  isVerifiedByStaff Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  addressId         String?
  businessId        String
  userId            String
  staffId           String?
   googleEventId  String?
  address           Address?      @relation(fields: [addressId], references: [id])
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff             StaffProfile? @relation(fields: [staffId], references: [id])
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             BookingItem[]
  ratings           Rating[]
  reminderLogs      BookingReminderLog[]

  @@index([businessId, staffId, startTime, endTime])
  @@index([userId])
  @@index([addressId])
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  itemId    String
  price     Float
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([itemId])
}

model BookingReminderLog {
  id           String    @id @default(cuid())
  bookingId    String
  milestone    String    // e.g., "1_DAY", "2_HOURS", "30_MINUTES", "5_MINUTES"
  scheduledFor DateTime  // <--- This line defines the field for your timeline records
  sentAt       DateTime? // NULL = pending queue item, TIMESTAMP = completed send
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, milestone])
  @@index([scheduledFor, sentAt]) // Now Prisma sees the field definition above!
  @@index([bookingId])
}


model GoogleCredential {
  id           String   @id @default(cuid())
  businessId   String   @unique
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  accessToken  String   @db.Text
  refreshToken String   @db.Text // Critical for background refreshes
  expiresAt    DateTime // Expiration timestamp
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DailyEmailQuotaTracker {
  date       String   @id // Formatted as "YYYY-MM-DD" for simple query aggregation
  emailCount Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  code            String      @unique
  userId          String
  businessId      String
