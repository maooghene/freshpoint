  @@index([businessId])
  @@index([userId])
  @@index([addressId])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  itemId   String
  quantity Int
  price    Float
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
